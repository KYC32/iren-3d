{
  "name": "iren-3d",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "IREN 데이터센터 현황을 전략게임풍 3D로 보여주는 비공식 대시보드",
  "scripts": {
    "predev": "npm run data",
    "dev": "vite --port 5173 --strictPort",
    "build": "vite build",
    "preview": "vite preview --port 4174",
    "data": "node scripts/build-data.mjs",
    "validate": "node scripts/validate.mjs",
    "geo": "node scripts/build-land-hex.mjs && node scripts/build-borders.mjs && node scripts/build-board-hex.mjs",
    "geo:fetch": "node scripts/fetch-natural-earth.mjs",
    "prebuild": "npm run data && npm run validate",
    "postbuild": "node scripts/check-size.mjs",
    "pretest": "npm run data",
    "test": "vitest run",
    "record": "npm run build && node scripts/record-server.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "lucide-react": "^1.52.0",
    "maplibre-gl": "^6.13.0",
    "react": "~19.3.0",
    "react-dom": "~19.3.0",
    "three": "^0.186.1",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "h3-js": "^4.5.0",
    "topojson-client": "^3.1.0",
    "us-atlas": "^3.0.1",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "world-atlas": "^2.0.2"
  }
}
